# Frontend configuration (Vite). Copy to .env.local (git-ignored) and adjust. No secrets belong here.
# Values are read at BUILD time: changing them needs a rebuild/redeploy, never a code change.

# Backend API base URL (without /api).
VITE_API_BASE_URL=http://localhost:8080

# Public guest menu base URL used for QR codes, print layouts and guest links: {base}/{businessId}/menu.
# Must be https (http is allowed only for localhost, 127.0.0.1, [::1] and *.localhost); no credentials, query
# or fragment. An invalid value disables QR codes and guest links instead of printing a wrong address.
# Leave it unset to keep the current production address that existing QR codes point to.
VITE_PUBLIC_MENU_BASE_URL=http://localhost:5175
